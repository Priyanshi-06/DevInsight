SECRET_KEY=change-me-to-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Chat completions ---
# Any OpenAI-compatible API works. Two easy options:
#
# Option A: Groq (free tier, fast) — get a key at https://console.groq.com/keys
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_CHAT_MODEL=llama-3.3-70b-versatile
#
# Option B: OpenAI — get a key at https://platform.openai.com/api-keys
# LLM_API_KEY=sk-...
# LLM_BASE_URL=
# LLM_CHAT_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_CHAT_MODEL=llama-3.3-70b-versatile

# --- Embeddings ---
# 'local' (default) runs a free sentence-transformers model on CPU — no API key needed.
# Groq has no embeddings endpoint, so embeddings stay local even when chat uses Groq.
# Set to 'openai' instead to use OpenAI's embeddings API (requires OPENAI_API_KEY below).
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: raises GitHub's unauthenticated rate limit if you hit it
GITHUB_TOKEN=

CHROMA_PERSIST_DIR=./chroma_data
