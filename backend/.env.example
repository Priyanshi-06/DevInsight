SECRET_KEY=change-me-to-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Vite picks the next free port if 5173 is taken (5174, 5175, ...) — list every port you might
# actually land on, since Django rejects requests from any origin not on this list.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# --- Chat completions ---
# Any OpenAI-compatible API works. Two easy options:
#
# Option A: Groq (free tier, fast) — get a key at https://console.groq.com/keys
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_CHAT_MODEL=llama-3.3-70b-versatile
#
# Option B: OpenAI — get a key at https://platform.openai.com/api-keys
# LLM_API_KEY=sk-...
# LLM_BASE_URL=
# LLM_CHAT_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_CHAT_MODEL=llama-3.3-70b-versatile

# --- Embeddings ---
# 'local' (default) runs a free sentence-transformers model on CPU — no API key needed.
# Groq has no embeddings endpoint, so embeddings stay local even when chat uses Groq.
# Set to 'openai' instead to use OpenAI's embeddings API (requires OPENAI_API_KEY below).
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: raises GitHub's unauthenticated rate limit if you hit it
GITHUB_TOKEN=

CHROMA_PERSIST_DIR=./chroma_data

# --- Password reset emails (sends a 6-digit code, not a link) ---
# Defaults to printing the reset email to this server's terminal — works with zero setup for
# local development. For real delivery, switch to the SMTP backend and fill in the EMAIL_HOST_*
# vars (e.g. Gmail SMTP, SendGrid, Mailgun, etc.):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@devinsight.local
